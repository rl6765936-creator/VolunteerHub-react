# Copy to .env for local development: cp .env.example .env
# Never commit .env or real secrets. On Windows, setup\setup-volunteerhub.bat writes .env for you.

# development | test | production
NODE_ENV=development

# 3001 so VolunteerHub can run next to VoiceUp (3000).
PORT=3001

# debug | info | warn | error | silent
# Default when omitted: debug (development), info (production), silent (test)
LOG_LEVEL=debug

# PostgreSQL connection string (required). Use a VolunteerHub-only database and user.
DATABASE_URL=postgresql://volunteerhub:CHANGE_ME@localhost:5432/volunteerhub_dev

# Secret for signing access tokens (required, at least 32 characters). Choose your own.
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-chars

# Access token lifetime in seconds (default 7200 = 2 hours). There are no refresh tokens.
JWT_EXPIRES_IN_SECONDS=7200

# Comma-separated list of browser origins allowed by CORS (the VolunteerHub frontend).
# Leave empty to disallow all cross-origin browser requests.
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops to trust for client IP detection (0 = none).
# Set to 1 when running behind a single proxy/load balancer so rate limiting sees real client IPs.
TRUST_PROXY=0

# Global API rate limit: max requests per client IP per window (the health checks are exempt).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Register/login attempts per IP per window.
AUTH_RATE_LIMIT_MAX=20
# Creating requests, offers and tasks, and image uploads, per IP per hour.
WRITE_RATE_LIMIT_MAX=30

# Time zone used to match task days with volunteers' available weekdays.
TIME_ZONE=Asia/Jerusalem

# Used by `npm run db:seed` only: the first admin account (password: at least 12 characters).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password
SEED_ADMIN_NAME=VolunteerHub Admin

# Used by the test suite only. The database name must end with "_test"; it is wiped on every run.
DATABASE_URL_TEST=postgresql://volunteerhub:CHANGE_ME@localhost:5432/volunteerhub_test

# Copy to .env for local development: cp .env.example .env
# Never commit .env or real secrets.

# development | test | production
NODE_ENV=development

# 3001 so VolunteerHub can run next to VoiceUp (3000).
PORT=3001

# debug | info | warn | error | silent
# Default when omitted: debug (development), info (production), silent (test)
LOG_LEVEL=debug

# PostgreSQL connection string (required). Use a VolunteerHub-only database and user.
DATABASE_URL=postgresql://volunteerhub:CHANGE_ME@localhost:5432/volunteerhub_dev

# Comma-separated list of browser origins allowed by CORS (the VolunteerHub frontend).
# Leave empty to disallow all cross-origin browser requests.
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops to trust for client IP detection (0 = none).
TRUST_PROXY=0

# Global API rate limit: max requests per client IP per window (the health check is exempt).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Used by the test suite only. The database name must end with "_test"; it is wiped on every run.
DATABASE_URL_TEST=postgresql://volunteerhub:CHANGE_ME@localhost:5432/volunteerhub_test

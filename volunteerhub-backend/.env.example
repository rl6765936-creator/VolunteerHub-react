# Copy to .env for local development: cp .env.example .env
# Never commit .env or real secrets.
# Database (Phase 2) and JWT (Phase 3) settings are added in the phases that use them.

# development | test | production
NODE_ENV=development

# 3001 so VolunteerHub can run next to VoiceUp (3000).
PORT=3001

# debug | info | warn | error | silent
# Default when omitted: debug (development), info (production), silent (test)
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed by CORS (the VolunteerHub frontend).
# Leave empty to disallow all cross-origin browser requests.
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops to trust for client IP detection (0 = none).
TRUST_PROXY=0

# Global API rate limit: max requests per client IP per window (the health check is exempt).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
